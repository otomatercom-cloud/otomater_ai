<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_list" model="ir.ui.view">
        <field name="name">ai.provider.list</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="model"/>
                <field name="is_default"/>
                <field name="is_embedding_provider" string="Embeddings"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ai_provider_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Production OpenAI"/></h1>
                    </div>
                    <group>
                        <group string="Provider">
                            <field name="code"/>
                            <field name="model" placeholder="gpt-4o-mini / claude-sonnet-4-6 / gemini-2.0-flash / llama3.1"/>
                            <field name="is_default"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Connection">
                            <field name="api_key" password="True"/>
                            <field name="api_base_url"/>
                            <field name="api_version" invisible="code != 'azure_openai'"/>
                            <field name="timeout"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group>
                        <group string="Generation Settings">
                            <field name="temperature"/>
                            <field name="max_tokens"/>
                        </group>
                        <group string="Cost Tracking">
                            <field name="cost_per_1k_input"/>
                            <field name="cost_per_1k_output"/>
                        </group>
                    </group>
                    <group string="Last Connection Test" invisible="not last_test_result">
                        <field name="last_test_result" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Knowledge Base Embeddings">
                        <field name="is_embedding_provider"/>
                        <field name="embedding_model" invisible="not is_embedding_provider"
                               placeholder="text-embedding-3-small / text-embedding-004 / nomic-embed-text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_provider" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">list,form</field>
        <field name="help">Configure the LLM providers Otomater AI can use (OpenAI, Claude, Gemini, Ollama, Azure OpenAI, OpenRouter).</field>
    </record>
</odoo>

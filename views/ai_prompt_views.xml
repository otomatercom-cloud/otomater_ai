<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_prompt_list" model="ir.ui.view">
        <field name="name">ai.prompt.list</field>
        <field name="model">ai.prompt</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="agent_id"/>
                <field name="use_count"/>
                <button name="action_use_prompt" type="object" string="Use in Chat" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_ai_prompt_form" model="ir.ui.view">
        <field name="name">ai.prompt.form</field>
        <field name="model">ai.prompt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_use_prompt" type="object" string="Use in Chat" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="agent_id"/>
                        </group>
                        <group>
                            <field name="use_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Prompt Text">
                        <field name="content" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_prompt_search" model="ir.ui.view">
        <field name="name">ai.prompt.search</field>
        <field name="model">ai.prompt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category"/>
                <field name="agent_id"/>
                <separator/>
                <filter string="Group By Category" name="group_category" context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_ai_prompt" model="ir.actions.act_window">
        <field name="name">Prompt Library</field>
        <field name="res_model">ai.prompt</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help">Reusable prompts by department. Click "Use in Chat" to open AI Chat with the prompt pre-filled.</field>
    </record>
</odoo>
